{
  "name": "ricky-finance",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:installer": "node scripts/build-installer.js",
    "predeploy": "npm run build:installer",
    "db:init": "wrangler d1 execute ricky-finance-db --file=schema.sql --local",
    "db:init:remote": "wrangler d1 execute ricky-finance-db --file=schema.sql",
    "db:create": "wrangler d1 create ricky-finance-db"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.98.0"
  }
}
